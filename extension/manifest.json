{
  "manifest_version": 3,
  "name": "Job Apply Agent",
  "key": "",
  "version": "0.1.0",
  "description": "AI-powered job application assistant — tailors resume and cover letter to each posting.",
  "permissions": ["activeTab", "tabs", "storage", "scripting", "identity"],
  "host_permissions": [
    "http://localhost:3001/*"
  ],
  "oauth2": {
    "client_id": "477082079479-a6oldbmsj8u5dhn7plcf9s7ff8u4p76b.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "background": {
    "service_worker": "dist/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Apply Agent"
  }
}
